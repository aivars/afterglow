    "A quick rating helps more people find the app and keeps us improving.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quick rating helps more people find the app and keeps us improving."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kurze Bewertung hilft mehr Menschen, die App zu finden, und motiviert uns, besser zu werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una valoración rápida ayuda a que más personas encuentren la app y nos impulsa a seguir mejorando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une note rapide aide plus de personnes à découvrir l’app et nous encourage à nous améliorer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간단한 별점 하나가 더 많은 사람이 앱을 찾는 데 도움이 되고, 저희가 계속 발전하는 힘이 됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簡單評個分，就能讓更多人發現這款 App，也讓我們持續進步。"
          }
        }
      }
    },
